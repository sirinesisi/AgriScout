<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.5 0.7 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.30 0.40 0.15 1</ambient><diffuse>0.30 0.40 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="path_1">
      <static>true</static>
      <pose>4.65 0.00 0.002 0 0 0.00</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>8.90 0.90 0.004</size></box></geometry>
          <material><ambient>0.55 0.45 0.30 1</ambient><diffuse>0.55 0.45 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="bed_1a">
      <static>true</static>
      <pose>4.35 -0.80 0.030 0 0 0.00</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>7.30 0.50 0.060</size></box></geometry>
          <material><ambient>0.25 0.17 0.10 1</ambient><diffuse>0.25 0.17 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>
